# Veritabanı (geliştirmede SQLite; üretimde PostgreSQL önerilir)
DATABASE_URL="file:./dev.db"

# Oturum imzalama anahtarı — en az 32 karakter, rastgele üretin: openssl rand -base64 48
SESSION_SECRET="degistir-bunu-en-az-32-karakterlik-rastgele-bir-anahtar"

# İlk admin hesabı (npm run db:seed ile oluşturulur)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="degistir-bunu"

# Kartla bakiye yükleme sağlayıcısı: "mock" (yalnızca geliştirme/test) veya "none" (kapalı)
PAYMENT_PROVIDER="mock"

# Zamanlayıcıyı uygulama içinde çalıştır (tek sunucu kurulumu için "true")
ENABLE_SCHEDULER="true"

# Harici cron ile /api/cron/run çağırmak için gizli anahtar
CRON_SECRET="degistir-bunu"

# Oturum çerezi yalnızca HTTPS ile gönderilsin mi? Boşsa üretimde "true".
# Alan adı + SSL olmadan, düz IP ile çalıştırırken "false" yapın.
COOKIE_SECURE=""

# SMS ve SMTP ayarları admin paneli → Entegrasyonlar'dan girilir (şifreler veritabanında şifreli saklanır).
# Aşağıdaki değerler yalnızca panelde hiç girilmemiş alanlar için yedek olarak kullanılır.

# SMS (telefon doğrulama ve şifre sıfırlama)
# "netgsm": gerçek gönderim | "log": SMS gönderilmez, kod sunucu loguna yazılır (yalnızca test)
SMS_PROVIDER="log"
# Netgsm panelinde oluşturulan API alt kullanıcısı (kullanıcı kodu = abone numarası, örn. 850XXXXXXX)
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
# Onaylı gönderici adı (mesaj başlığı)
NETGSM_MSGHEADER=""
# "otp" (Netgsm OTP SMS paketi, önerilen) veya "sms" (normal SMS)
NETGSM_ENDPOINT="otp"

# IP adresi değişince oturumu kapat ("false" ile kapatılabilir)
SESSION_BIND_IP="true"

# SMTP (yedek e-posta; panelden de girilebilir)
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
