# Veritabanı (geliştirmede SQLite; üretimde PostgreSQL önerilir)
DATABASE_URL="file:./dev.db"

# Oturum imzalama anahtarı — en az 32 karakter, rastgele üretin: openssl rand -base64 48
SESSION_SECRET="degistir-bunu-en-az-32-karakterlik-rastgele-bir-anahtar"

# İlk admin hesabı (npm run db:seed ile oluşturulur)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="degistir-bunu"

# Kartla bakiye yükleme sağlayıcısı: "mock" (yalnızca geliştirme/test) veya "none" (kapalı)
PAYMENT_PROVIDER="mock"

# Zamanlayıcıyı uygulama içinde çalıştır (tek sunucu kurulumu için "true")
ENABLE_SCHEDULER="true"

# Harici cron ile /api/cron/run çağırmak için gizli anahtar
CRON_SECRET="degistir-bunu"
